# Core trading mode
TRADING_MODE=paper
DRY_RUN=true
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACKNOWLEDGEMENT=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Portfolio and risk limits
STARTING_CAPITAL=500
RISK_PER_TRADE=0.10
MAX_POSITION_SIZE=0.20
MAX_ACTIVE_POSITIONS=5
MAX_DAILY_LOSS_PERCENT=0.05
STOP_LOSS_PERCENT=0.05
TAKE_PROFIT_PERCENT=0.15
POSITION_HOLD_TIME=86400

# Scanner configuration
STOCKS=AAPL,MSFT,NVDA,TSLA
PRIMARY_STOCK=AAPL
GOLD_MINE_THRESHOLD=0.75
SCAN_INTERVAL=30
MARKET_TIMEZONE=America/New_York
MARKET_OPEN=09:30
MARKET_CLOSE=16:00
TRADING_DAYS=0,1,2,3,4
DATABASE_PATH=trading.db

# News and alerts
NEWS_API_KEY=demo
DISCORD_WEBHOOK=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_ALERTS=false
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Dashboard
# WARNING: The dashboard has no built-in authentication.
# Keep DASHBOARD_HOST=127.0.0.1 and use a VPN or authenticated reverse proxy
# if you need remote access.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_PUBLIC_BASE_URL=
