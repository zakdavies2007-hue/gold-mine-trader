# ============================================================
# Gold Mine Trader – Environment Configuration
# Copy this file to .env and fill in your values.
# Do NOT commit .env to source control.
# ============================================================

# ----------------------------------------------------------------
# STOCKS
# ----------------------------------------------------------------
STOCKS=AAPL,MSFT,NVDA,TSLA
PRIMARY_STOCK=AAPL
GOLD_MINE_THRESHOLD=0.75
SCAN_INTERVAL=30

# ----------------------------------------------------------------
# CAPITAL & POSITION MANAGEMENT
# ----------------------------------------------------------------
STARTING_CAPITAL=500
RISK_PER_TRADE=0.10       # Fraction of capital per trade (0.10 = 10%)
STOP_LOSS_PERCENT=0.05    # 5% below entry
TAKE_PROFIT_PERCENT=0.15  # 15% above entry
MAX_POSITION_SIZE=0.20    # Max 20% of capital in one position
MAX_ACTIVE_POSITIONS=5
POSITION_HOLD_TIME=86400  # Seconds (86400 = 24 h)

# ----------------------------------------------------------------
# ALPACA BROKER
# ----------------------------------------------------------------
# For paper trading (fake money):
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# For live trading (real money):
# ALPACA_BASE_URL=https://api.alpaca.markets

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Set to false only when you are ready for real-money trading.
# Degraded detections are NEVER executed regardless of this flag.
DRY_RUN=true

# ----------------------------------------------------------------
# SAFETY – Daily Loss Limit
# ----------------------------------------------------------------
# Expressed as a positive fraction (e.g. 0.05 = stop after 5% loss).
# The process stops opening new positions when daily P&L <= -(capital * limit).
MAX_DAILY_LOSS_PERCENT=0.05

# ----------------------------------------------------------------
# NEWS API (optional – enables news-enriched scoring)
# ----------------------------------------------------------------
# Leave empty to run in technical-only mode.
# Without a valid key, the sentiment component is degraded, which
# makes all signals ineligible for execution.
# Free key available at https://newsapi.org
NEWS_API_KEY=

# ----------------------------------------------------------------
# FINBERT SENTIMENT MODEL (optional)
# ----------------------------------------------------------------
# Set to true to disable loading the FinBERT transformer model.
# When disabled, all signals are marked degraded (ineligible for execution).
DISABLE_FINBERT=false

# ----------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------
# Path to the SQLite database file.
# The parent directory is created automatically if it does not exist.
DATABASE_PATH=trading.db

# ----------------------------------------------------------------
# DASHBOARD
# ----------------------------------------------------------------
# WARNING: The dashboard has NO built-in authentication.
# Do NOT expose it on a public interface without an external proxy.
# Bind to loopback (127.0.0.1) in production.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# ----------------------------------------------------------------
# NOTIFICATIONS (all optional)
# ----------------------------------------------------------------
# Discord
DISCORD_WEBHOOK=
DISCORD_ALERTS=false

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS=false

# Email (SMTP)
EMAIL_ALERTS=false
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ----------------------------------------------------------------
# MARKET HOURS (US/Eastern, UTC-4 in summer)
# ----------------------------------------------------------------
MARKET_OPEN=9.5    # 09:30
MARKET_CLOSE=16.0  # 16:00
TRADING_DAYS=0,1,2,3,4   # 0=Monday … 4=Friday

# ----------------------------------------------------------------
# ADVANCED
# ----------------------------------------------------------------
LOG_LEVEL=INFO
MAX_WORKERS=4
